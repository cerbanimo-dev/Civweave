# Public URL other nodes use to reach this node. Use HTTPS for Internet federation.
PUBLIC_HOST_URL=http://localhost:8787

# Human-readable node identity.
COMMONWEAVE_NODE_NAME=Commonweave Community Node
COMMONWEAVE_NODE_DESCRIPTION=A sovereign Commonweave community node.

# Host port exposed by Docker Compose.
COMMONWEAVE_PORT=8787

# New peers remain pending until approved unless this is true.
COMMONWEAVE_AUTO_ACCEPT_PEERS=false

# Comma-separated advertised capabilities.
COMMONWEAVE_NODE_CAPABILITIES=release-distribution,node-discovery,federated-events,fellowfare.exchange,living-school.curricula,anarchadia.proposals,portable-proofs

# Maximum retained federated events.
COMMONWEAVE_MAX_FEDERATION_EVENTS=5000

# Optional token protecting the legacy Commonweave host-node API.
HUB_TOKEN=
