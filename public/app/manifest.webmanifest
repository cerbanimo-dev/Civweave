{
  "name": "Civweave v1.0.163",
  "short_name": "Civweave",
  "description": "Five connected, offline-ready Civweave systems with deterministic local operation and a non-modal AI settings layer.",
  "id": "/civweave-local",
  "start_url": "/app/pwa-start-v436.html?installed=1&system=civweave&source=pwa-manifest-v436",
