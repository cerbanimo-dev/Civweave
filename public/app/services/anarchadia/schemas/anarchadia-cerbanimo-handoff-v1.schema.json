{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anarchadia.local/schemas/anarchadia-cerbanimo-handoff-v1.schema.json",
  "title": "Anarchadia to Cerbanimo constitutional artifact handoff",
  "description": "A minimized, record-only, default-off handoff. Receipt creates no governance effect.",
  "type": "object",
  "required": ["schema", "sourceCommunityScopedRef", "artifactRef", "artifactKind", "declaredVersion", "declaredStatus", "conflictState", "manualReviewRequired", "automaticEffect", "authorityDisclaimer"],
  "properties": {
    "schema": {"const": "anarchadia.constitutional-artifact.v1"},
    "generatedAt": {"type": "string"},
    "sourceCommunityScopedRef": {"type": "string"},
    "artifactRef": {"type": "string"},
    "artifactKind": {"enum": ["charter", "proposal", "declared-outcome", "amendment", "bridge-contract"]},
    "declaredVersion": {"type": ["integer", "string"]},
    "declaredStatus": {"type": "string"},
    "conflictState": {"type": "string"},
    "expiry": {"type": "string"},
    "manualReviewRequired": {"const": true},
    "automaticEffect": {"const": false},
    "authorityDisclaimer": {"type": "string", "minLength": 20}
  },
  "additionalProperties": false
}
