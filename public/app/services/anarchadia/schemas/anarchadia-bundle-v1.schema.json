{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anarchadia.local/schemas/anarchadia-bundle-v1.schema.json",
  "title": "Anarchadia manual exchange bundle v1",
  "type": "object",
  "required": ["bundleVersion", "recordSchema", "bundleRef", "source", "manifest", "payload"],
  "properties": {
    "bundleVersion": {"const": "anarchadia.bundle.v1"},
    "recordSchema": {"const": "anarchadia.community-record.v1"},
    "bundleRef": {"type": "string", "minLength": 8},
    "exportedAt": {"type": "string"},
    "exportedAtNote": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["communityRef", "communityName", "mode", "syntheticOnly"],
      "properties": {
        "communityRef": {"type": "string"},
        "communityName": {"type": "string"},
        "mode": {"enum": ["synthetic", "pilot-draft"]},
        "syntheticOnly": {"type": "boolean"},
        "appVersion": {"type": "string"}
      },
      "additionalProperties": true
    },
    "manifest": {
      "type": "object",
      "required": ["purpose", "intendedAudience", "classes", "omissions", "privacyMarking", "onwardExportRule", "replicaUncertainty", "authorityDisclaimer", "payloadSha256"],
      "properties": {
        "classes": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "payloadSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "conflictsPresent": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
