{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anarchadia.local/schemas/bridge-contract-template-v1.schema.json",
  "title": "Default-off ecosystem bridge contract template",
  "type": "object",
  "required": ["name", "direction", "purpose", "recipientClass", "fields", "retention", "expiry", "revocation", "failureClosed", "reidentificationRisk", "manualAlternative", "enabled"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "direction": {"type": "string", "description": "Exactly one direction."},
    "purpose": {"type": "string", "description": "Exactly one bounded purpose."},
    "recipientClass": {"type": "string", "description": "Exactly one recipient class."},
    "fields": {"type": "string"},
    "metadata": {"type": "string"},
    "retention": {"type": "string"},
    "expiry": {"type": "string"},
    "revocation": {"type": "string"},
    "failureClosed": {"type": "string"},
    "reidentificationRisk": {"type": "string"},
    "manualAlternative": {"type": "string"},
    "enabled": {"const": false}
  },
  "additionalProperties": true
}
