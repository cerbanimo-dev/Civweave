{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civweave.local/schemas/exchange-bundle-1.0.0.schema.json",
  "title": "Civweave Exchange Bundle",
  "description": "Portable Fellowfare market entities and event history prepared for Civweave ingestion.",
  "type": "object",
  "required": ["format", "schemaVersion", "exportedAt", "source", "entities", "events", "mapping"],
  "properties": {
    "format": { "const": "civweave.exchange-bundle" },
    "schemaVersion": { "const": "1.0.0" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["app", "version", "nodeId"],
      "properties": {
        "app": { "const": "Fellowfare" },
        "version": { "type": "string" },
        "nodeId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "entities": {
      "type": "object",
      "required": ["people", "threads", "proposals", "assemblies", "agreements"],
      "properties": {
        "people": { "type": "array", "items": { "type": "object", "required": ["id"] } },
        "threads": { "type": "array", "items": { "$ref": "#/$defs/thread" } },
        "proposals": { "type": "array", "items": { "$ref": "#/$defs/proposal" } },
        "assemblies": { "type": "array", "items": { "$ref": "#/$defs/assembly" } },
        "agreements": { "type": "array", "items": { "$ref": "#/$defs/agreement" } }
      },
      "additionalProperties": false
    },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "mapping": {
      "type": "object",
      "required": ["thread", "proposal", "assembly", "agreement", "milestone", "evidence", "settlement", "review"],
      "additionalProperties": { "type": "string" }
    }
  },
  "$defs": {
    "thread": {
      "type": "object",
      "required": ["id", "ownerId", "mode", "title", "description", "status", "createdAt"],
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "mode": { "enum": ["need", "offer", "collective"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "proposal": {
      "type": "object",
      "required": ["id", "threadId", "fromId", "message", "status", "createdAt"],
      "properties": {
        "id": { "type": "string" },
        "threadId": { "type": "string" },
        "fromId": { "type": "string" },
        "message": { "type": "string" },
        "status": { "enum": ["pending", "accepted", "declined", "withdrawn"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "assembly": {
      "type": "object",
      "required": ["id", "threadId", "title", "status", "commitments"],
      "properties": {
        "id": { "type": "string" },
        "threadId": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string" },
        "commitments": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": true
    },
    "agreement": {
      "type": "object",
      "required": ["id", "threadId", "title", "participants", "terms", "milestones", "evidence", "settlement", "recurrence", "repair", "reviews", "status", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string" },
        "threadId": { "type": "string" },
        "proposalId": { "type": "string" },
        "title": { "type": "string" },
        "participants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["personId", "role", "confirmedAt"],
            "properties": {
              "personId": { "type": "string" },
              "role": { "type": "string" },
              "confirmedAt": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "terms": { "type": "object" },
        "milestones": { "type": "array", "items": { "$ref": "#/$defs/milestone" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "settlement": { "$ref": "#/$defs/settlement" },
        "recurrence": { "type": "object" },
        "repair": { "type": "object" },
        "reviews": { "type": "array", "items": { "$ref": "#/$defs/review" } },
        "status": { "enum": ["draft", "active", "fulfilled", "settled", "repair", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "milestone": {
      "type": "object",
      "required": ["id", "title", "ownerId", "status", "evidenceIds"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "ownerId": { "type": "string" },
        "dueAt": { "type": "string" },
        "status": { "enum": ["pending", "complete", "waived"] },
        "completedAt": { "type": "string" },
        "evidenceIds": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["id", "kind", "label", "addedBy", "createdAt"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["note", "link", "receipt", "photo-reference"] },
        "label": { "type": "string" },
        "url": { "type": "string" },
        "note": { "type": "string" },
        "addedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "settlement": {
      "type": "object",
      "required": ["status", "method", "currency", "note", "recordedAt"],
      "properties": {
        "status": { "enum": ["pending", "recorded", "settled", "waived"] },
        "method": { "type": "string" },
        "amount": { "type": ["number", "null"] },
        "currency": { "type": "string" },
        "note": { "type": "string" },
        "recordedAt": { "type": "string" }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["id", "fromId", "toId", "context", "ratings", "note", "createdAt"],
      "properties": {
        "id": { "type": "string" },
        "fromId": { "type": "string" },
        "toId": { "type": "string" },
        "context": { "type": "string" },
        "ratings": { "type": "object" },
        "note": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["id", "type", "entityType", "entityId", "actorId", "timestamp", "payload"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "actorId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "payload": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
