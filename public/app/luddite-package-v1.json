{
  "schema": "civweave.luddite-package.v1",
  "mode": "luddite",
  "label": "Luddite Mode",
  "entry": "/app/luddite-campus-v1.html",
  "policy": {
    "recursiveDiscovery": false,
    "aiGeneration": false,
    "localModels": false,
    "remoteModels": false,
    "humanAuthoredOnlyFeed": true,
    "unknownProvenanceFailsClosed": true,
    "humanValidation": true
  },
  "assets": [
    "/app/luddite-campus-v1.html",
    "/app/content-provenance-v1.js",
    "/app/luddite-mode-v1.js",
    "/app/luddite-manual-authoring-v1.js",
    "/app/shared/civweave-reward-weave.js",
    "/app/logos/civweave-symbol.svg"
  ],
  "forbiddenPathFragments": [
    "/assets/ai/",
    "/local-ai/",
    "/models/",
    "/vendor/onnxruntime/",
    "family-ai-loader",
    "guide-chat",
    "assistant-runtime",
    "server-ai",
    "node-ai",
    "emergency-ai",
    "browser-agent",
    "minilm",
    "smollm",
    "gemini",
    "model-settings",
    "ai-settings"
  ]
}
