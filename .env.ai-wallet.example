# Hosted AI wallet is fail-closed. Leave disabled until every secret is set.
AI_WALLET_ENABLED=0

# Storage selection. File is for local development only; Postgres is required for multi-instance hosting.
AI_WALLET_STORAGE=file
# AI_WALLET_DATABASE_URL=postgresql://...
# DATABASE_URL may be used instead when AI_WALLET_DATABASE_URL is absent.
AI_WALLET_QUERY_TIMEOUT_MS=10000

# Generate four independent random values of at least 32 bytes each.
# Never reuse the Gemini provider credential for any of these fields.
AI_WALLET_CAPABILITY_SECRET=
AI_WALLET_AUTH_SECRET=
AI_WALLET_PAYMENT_SECRET=
AI_WALLET_INTERNAL_SECRET=

# Staging-only wallet preview. Keep disabled on production deployments.
# The staging secret must be independent from every secret above.
AI_WALLET_STAGING_ENABLED=0
AI_WALLET_STAGING_SECRET=
# Local tests may opt into file storage. Shared staging hosts must leave this disabled.
AI_WALLET_STAGING_ALLOW_FILE=0
# AI_WALLET_STAGING_URL=https://staging-host.example

# Install the optional Neon runtime only on a host that enables Postgres storage:
# npm run wallet:postgres:install

# The provider credential remains server-side and is intentionally not wired by this layer.
# GEMINI_API_KEY=
