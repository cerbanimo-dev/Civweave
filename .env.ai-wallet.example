# Hosted AI wallet is fail-closed. Leave disabled until every secret is set.
AI_WALLET_ENABLED=0

# Generate four independent random values of at least 32 bytes each.
# Never reuse the Gemini provider credential for any of these fields.
AI_WALLET_CAPABILITY_SECRET=
AI_WALLET_AUTH_SECRET=
AI_WALLET_PAYMENT_SECRET=
AI_WALLET_INTERNAL_SECRET=

# The provider key remains server-side and is intentionally not wired by this foundation.
# GEMINI_API_KEY=
