# Civweave Node AI marketplace is fail-closed. Enabling this creates a node-local
# prepaid inference gate. It does not create a central Civweave wallet.
NODE_AI_MARKETPLACE_ENABLED=0
# Compatibility flag accepted during the migration. Prefer NODE_AI_MARKETPLACE_ENABLED.
AI_WALLET_ENABLED=0

# New nodes create a stable node ID, operator ID, Ed25519 receipt identity, auth
# secret, capability secret and internal operator secret automatically on first start.
# They persist under DATA_DIR/node-ai-bootstrap-v1.json with private file permissions.
# These variables are optional migration/recovery overrides only. Do not provision
# them across a fleet of new nodes.
NODE_AI_NODE_ID=
NODE_AI_OPERATOR_ID=
NODE_AI_RECEIPT_PRIVATE_KEY=
NODE_AI_RECEIPT_PUBLIC_KEY=
NODE_AI_RECEIPT_KEY_ID=
NODE_AI_CAPABILITY_SECRET=
NODE_AI_AUTH_SECRET=
NODE_AI_PAYMENT_WEBHOOK_SECRET=
NODE_AI_INTERNAL_SECRET=
NODE_AI_BOOTSTRAP_PATH=

NODE_AI_DISPLAY_NAME=
NODE_AI_LEDGER_PATH=./data/node-ai-ledger-v1.sqlite

# Optional comma-separated public HTTP(S) origins/base URLs advertised for direct
# capability and inference calls. A live-money node needs at least one public HTTPS
# origin so Cerbanimo can challenge the node and deliver verified payment events.
NODE_AI_PUBLIC_BASE_URLS=

# Optional PUBLIC location for map discovery. Leave both blank unless the operator
# deliberately wants this node plotted. These are never inferred from private data.
NODE_AI_PUBLIC_LATITUDE=
NODE_AI_PUBLIC_LONGITUDE=

# Local/sandbox accounting preview only. This value is NOT authoritative for live
# Cerbanimo application fees. The trusted Cerbanimo money edge assigns and signs the
# live platform fee during payout enrollment.
NODE_AI_PLATFORM_FEE_BPS=0

# JSON array of the node's advertised services. The node operator chooses models,
# providers, local hardware, RAG and agent runtimes behind these services.
NODE_AI_SERVICES_JSON=

# Optional local JavaScript module implementing the advertised services. The module
# stays on the node and must export a package with quote()/execute() handlers.
# HTTP(S) package URLs are rejected; mesh adverts never distribute executable code.
NODE_AI_SERVICE_PACKAGE_MODULE=

# Optional Fireworks reference package. To use it, set NODE_AI_SERVICE_PACKAGE_MODULE
# to ./examples/node-ai-fireworks-package-v1.mjs and provide the node-owned key below.
# Provider credentials belong only to that node operator and never to Cerbanimo.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-flash
FIREWORKS_SERVICE_IDS=general
FIREWORKS_TIMEOUT_MS=120000

# Operator disclosures published in the node service manifest.
NODE_AI_RETENTION_POLICY=operator-declared
NODE_AI_THIRD_PARTY_INFERENCE=0
NODE_AI_SETTLEMENT_CADENCE=periodic
NODE_AI_MESH_SETTLEMENT_PUBLICATION=1

# Sandbox-only commerce exercises pairing, credits, refunds, chargebacks, debt,
# reservations and receipts using the real node ledger. It never invokes a payment
# processor and must be explicitly enabled by the operator.
# No payment processor account or Stripe platform credential belongs on a host node.
NODE_AI_TRIAL_COMMERCE_ENABLED=0
NODE_AI_TRIAL_MAX_TOPUP_CENTS=10000

# Live commerce. The canonical Cerbanimo money edge is Cloudflare core and is built
# into Civweave. Override only for development/migration. Its Ed25519 public key is
# fetched over HTTPS on first payout connection, fingerprint-checked, then pinned.
# New nodes do not receive Stripe keys, Cerbanimo private keys, or shared enrollment
# passwords. Payout enrollment uses a proof-of-key, short-lived, single-use grant.
NODE_AI_LIVE_COMMERCE_ENABLED=0
CIVWEAVE_MONEY_EDGE_URL=https://civweave-core.glaedn.workers.dev
CIVWEAVE_MONEY_EDGE_PUBLIC_KEY=
NODE_AI_LIVE_MAX_TOPUP_CENTS=100000
