{
  "provider": "stripe-connect-direct-v1",
  "operatorAccountType": "standard",
  "chargeModel": "direct-charge",
  "operatorPayouts": "stripe-connected-account-native",
  "currency": "USD",
  "liveMoneyEnabled": false,
  "emergencyStop": false,
  "requiredOperationalApprovals": [
    "compliance",
    "jurisdiction",
    "kyc-aml-readiness",
    "tax-reporting-readiness",
    "provider-terms"
  ],
  "secrets": {
    "moneyEdgeOnly": [
      "STRIPE_SECRET_KEY",
      "STRIPE_CONNECT_WEBHOOK_SECRET",
      "CIVWEAVE_MONEY_EDGE_PRIVATE_KEY",
      "CIVWEAVE_MONEY_EDGE_ADMIN_SECRET"
    ],
    "nodeOnly": [
      "NODE_AI_RECEIPT_PRIVATE_KEY",
      "NODE_AI_INTERNAL_SECRET",
      "NODE_AI_AUTH_SECRET"
    ],
    "publicPins": [
      "NODE_AI_RECEIPT_PUBLIC_KEY",
      "CIVWEAVE_MONEY_EDGE_PUBLIC_KEY"
    ]
  }
}
