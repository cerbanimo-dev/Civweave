{
  "schema": "civweave.launch-topology.v1",
  "platformFeeBps": 500,
  "economy": {
    "topup": {
      "basis": "net-service-after-processing",
      "systemBps": 7000,
      "hostBps": 2500,
      "cerbanimoBps": 500,
      "systemFundsCustody": "cloudflare-core-platform-reserve"
    },
    "membership": {
      "basis": "net-service-after-processing",
      "systemBps": 5000,
      "hostBps": 2500,
      "cerbanimoBps": 2500,
      "lifetimeCredits": "monthly-non-expiring-tier-grant"
    },
    "anchorStipend": {
      "currency": "button",
      "weeklyButtonsByIndependentAnchorRank": [3, 2, 1],
      "maxPaidAnchorsPerNode": 3,
      "separateFromComputeCompensation": true,
      "receiptSchema": "civweave.anchor-button-stipend.v1"
    }
  },
  "canonicalInstallOrigin": "https://civweave.pages.dev",
  "backbone": {
    "provider": "cloudflare",
    "staticProject": "civweave",
    "worker": "civweave-core",
    "publicApiOrigin": "https://civweave-core.glaedn.workers.dev",
    "roles": [
      "canonical-site-and-installer",
      "node-directory",
      "trust-root",
      "stripe-connect-authority",
      "stripe-webhook-authority",
      "money-edge-authority",
      "compute-reserve-custodian"
    ],
    "storage": {
      "registry": "cloudflare-d1",
      "payments": "cloudflare-d1",
      "packages": "optional-cloudflare-r2",
      "signingIdentity": "cloudflare-durable-object"
    },
    "moneyEdgeAuthority": true,
    "liveMoneyDefault": false
  },
  "cloudNodeFabric": {
    "provider": "cloudflare",
    "worker": "civweave-node-cloud",
    "publicFabricOrigin": "https://civweave-node-cloud.glaedn.workers.dev",
    "domain": "nodes.commonweave.earth",
    "wildcardDomain": "*.nodes.commonweave.earth",
    "customDomainStatus": "pending-zone-availability",
    "state": "one-sqlite-durable-object-per-node-plus-account-capacity-object-plus-anchor-registry-object",
    "maxStarterHostsPerAccount": 3,
    "roles": [
      "public-www-host-node",
      "seed-peer",
      "discovery",
      "pairing",
      "relay",
      "service-catalog",
      "websocket-presence",
      "stripe-connect-enrollment",
      "adaptive-compute-capacity",
      "local-anchor-recovery",
      "signed-anchor-stipends"
    ],
    "resilience": {
      "localAnchorRecommended": true,
      "localAnchorRequired": false,
      "defaultLocalSyncHours": 6,
      "cloudCheckpointRefresh": "daily",
      "proofFreshHours": 72,
      "checkpointFreshHours": 36,
      "minimumRecoveryCoverageBps": 9500,
      "statusClasses": ["cloud-only", "locally-anchored", "redundantly-anchored"],
      "irreversibleExternalSettlementDuringIncompleteRecovery": false
    },
    "containsStripePlatformSecret": false,
    "containsCerbanimoSigningPrivateKey": false
  },
  "physicalNodeFabric": {
    "protocol": "civweave.node.v1",
    "moneyEdgeUrl": "https://civweave-core.glaedn.workers.dev",
    "modes": [
      "cloudflare-tunnel-public-server",
      "cloudflare-relay-private-node",
      "local-anchor-backup"
    ],
    "supportedExamples": [
      "laptop",
      "raspberry-pi",
      "desktop",
      "nas",
      "home-server"
    ],
    "privateIdentityGeneratedLocally": true,
    "manualCerbanimoSecretsRequired": false,
    "manualStripeSecretsRequired": false
  },
  "transition": {
    "legacyCanonicalInstallOrigin": "https://commonweave.pages.dev",
    "renderFallbackDiscoverable": true,
    "renderIsAuthority": false,
    "renderMoneyEdgeEnabled": false,
    "cloudflareMoneyEdgeAuthority": true,
    "cloudflareMoneyEdgeLive": false,
    "conditionForLiveMoney": "Cloudflare core deployed with D1 migrations, Stripe sandbox secrets, webhook switched, and sandbox end-to-end checks green"
  }
}
