{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "civweave-money-edge",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-11",
  "services": [
    {
      "binding": "CORE",
      "service": "civweave-core"
    }
  ],
  "vars": {
    "CIVWEAVE_MONEY_EDGE_AUTHORITY": "cloudflare-core",
    "CIVWEAVE_MONEY_EDGE_PUBLIC_SURFACE": "cloudflare-pages"
  }
}
