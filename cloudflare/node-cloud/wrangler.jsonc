{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "civweave-node-cloud",
  "main": "src/server-ai-entry-v3.mjs",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      { "name": "NODES", "class_name": "CivweaveCloudNode" },
      { "name": "CAPACITY", "class_name": "CivweaveCapacityAccount" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CivweaveCloudNode"] },
    { "tag": "v2", "new_sqlite_classes": ["CivweaveCapacityAccount"] }
  ],
  "services": [
    { "binding": "CORE", "service": "civweave-core" }
  ],
  "vars": {
    "NODE_DOMAIN": "nodes.commonweave.earth",
    "PUBLIC_FABRIC_ORIGIN": "https://civweave-node-cloud.cerbanimo.workers.dev",
    "CIVWEAVE_CANONICAL_INSTALL_ORIGIN": "https://civweave.pages.dev",
    "CIVWEAVE_WORKERS_PLAN": "free",
    "CIVWEAVE_UNIFIED_BILLING_MODEL": "google/gemini-3.1-flash-lite",
    "CIVWEAVE_AI_GATEWAY_ID": "default"
  },
  "observability": { "enabled": true }

  // Central fabric secrets only, never distributed to community/physical nodes:
  // NODE_FABRIC_SESSION_SECRET
  // NODE_FABRIC_OPERATOR_TOKEN
  // NODE_FABRIC_BINDING_TOKEN
  //
  // Member capacity sessions use a domain-separated HMAC derived from the dedicated
  // session secret. The operator token remains a compatibility fallback only.
  // Neither raw secret is ever sent to clients.
  //
  // CIVWEAVE_WORKERS_PLAN is a deployment capability flag. Setting it to "paid"
  // only permits funded overage; it does not increase the 10,000-neuron free pool.
  // The AI Gateway route is selected only after per-user pool policy chooses it.
  // Lifetime credits always require explicit request permission before reservation.
  // This Worker intentionally has no Stripe platform key and no Cerbanimo money-edge private key.
}
