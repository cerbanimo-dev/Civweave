{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "civweave-node-cloud",
  "main": "src/server-ai-entry-v7.mjs",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "NODES", "class_name": "CivweaveCloudNode" },
      { "name": "CAPACITY", "class_name": "CivweaveCapacityAccount" },
      { "name": "ACCOUNT_DIRECTORY", "class_name": "CivweaveAccountDirectory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CivweaveCloudNode"] },
    { "tag": "v2", "new_sqlite_classes": ["CivweaveCapacityAccount"] },
    { "tag": "v3", "new_sqlite_classes": ["CivweaveAccountDirectory"] }
  ],
  "services": [
    { "binding": "CORE", "service": "civweave-core" },
    { "binding": "CERBANIMO_MAIL", "service": "cerbanimo-mail" }
  ],
  "vars": {
    "NODE_DOMAIN": "nodes.civweave.invalid",
    "PUBLIC_FABRIC_ORIGIN": "https://civweave-node-cloud.cerbanimo.workers.dev",
    "CIVWEAVE_CANONICAL_INSTALL_ORIGIN": "https://civweave.cc",
    "CIVWEAVE_ACCOUNT_DIRECTORY_ORIGIN": "https://civweave-node-cloud.cerbanimo.workers.dev",
    "CIVWEAVE_WORKERS_PLAN": "free",
    "CIVWEAVE_UNIFIED_BILLING_MODEL": "google/gemini-3.1-flash-lite",
    "CIVWEAVE_AI_GATEWAY_ID": "default"
  },
  "observability": { "enabled": true }

  // Central fabric secrets only, never distributed to community/physical nodes:
  // NODE_FABRIC_SESSION_SECRET
  // NODE_FABRIC_OPERATOR_TOKEN
  // NODE_FABRIC_BINDING_TOKEN
  //
  // Passport account security is established before Hub admission. Capacity sessions
  // are bound to an active paired device so device deactivation revokes live access.
  // Member Stripe connection is proxied through the authenticated account surface and
  // reuses FellowFare's Accounts v2 direct-commerce merchant rail.
  //
  // The ACCOUNT_DIRECTORY Durable Object stores only hashed recovery-email keys
  // and verified account locators. It never returns account existence before the
  // user has proved control of the email address.
  //
  // CERBANIMO_MAIL is an internal Cloudflare service binding. Recovery mail is
  // sent by the Cerbanimo mail Worker without exposing a public send endpoint.
  //
  // NODE_DOMAIN intentionally uses the reserved .invalid namespace until an
  // owned custom zone is explicitly configured. Public starter-node links are
  // repaired to their real account-edge workers.dev paths.
  //
  // Member capacity sessions use a domain-separated HMAC derived from the dedicated
  // session secret. The operator token remains a compatibility fallback only.
  // Neither raw secret is ever sent to clients.
  //
  // Browser Run is a delegated web tool. Downloaded/local models never leave the
  // device for inference; only explicit search queries or target URLs are sent to
  // this Worker when live research has been requested. Offline archive search does
  // not touch this binding.
  //
  // CIVWEAVE_WORKERS_PLAN is a deployment capability flag. Setting it to "paid"
  // only permits funded overage; it does not increase the 10,000-neuron free pool.
  // Hub hosting capacity is separate: unpaid/expired hosting permits 28 residents;
  // a paid hosting settlement permits up to 400 without changing per-user compute funding.
  // The AI Gateway route is selected only after per-user pool policy chooses it.
  // Lifetime credits always require explicit request permission before reservation.
  // This Worker intentionally has no Stripe platform key and no Cerbanimo money-edge private key.
}
