{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "civweave-node-cloud",
  "main": "src/server-ai-entry-v2.mjs",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NODES",
        "class_name": "CivweaveCloudNode"
      },
      {
        "name": "CAPACITY",
        "class_name": "CivweaveCapacityAccount"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CivweaveCloudNode"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["CivweaveCapacityAccount"]
    }
  ],
  "services": [
    {
      "binding": "CORE",
      "service": "civweave-core"
    }
  ],
  "vars": {
    "NODE_DOMAIN": "nodes.commonweave.earth",
    "PUBLIC_FABRIC_ORIGIN": "https://civweave-node-cloud.cerbanimo.workers.dev",
    "CIVWEAVE_WORKERS_PLAN": "free",
    "CIVWEAVE_UNIFIED_BILLING_MODEL": "google/gemini-3.1-flash-lite",
    "CIVWEAVE_AI_GATEWAY_ID": "default"
  },
  "observability": {
    "enabled": true
  }
}