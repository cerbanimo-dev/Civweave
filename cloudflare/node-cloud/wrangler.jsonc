{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "civweave-node-cloud",
  "main": "src/resilient-entry.mjs",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NODES",
        "class_name": "CivweaveCloudNode"
      },
      {
        "name": "CAPACITY",
        "class_name": "CivweaveCapacityAccount"
      },
      {
        "name": "ANCHORS",
        "class_name": "CivweaveAnchorRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CivweaveCloudNode"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["CivweaveCapacityAccount"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["CivweaveAnchorRegistry"]
    }
  ],
  "services": [
    {
      "binding": "CORE",
      "service": "civweave-core"
    }
  ],
  "triggers": {
    "crons": ["17 4 * * *"]
  },
  "vars": {
    "NODE_DOMAIN": "nodes.commonweave.earth",
    "PUBLIC_FABRIC_ORIGIN": "https://civweave-node-cloud.glaedn.workers.dev",
    "CIVWEAVE_WORKERS_PLAN": "free"
  },
  "observability": {
    "enabled": true
  }

  // Central fabric secrets only, never distributed to community/physical nodes:
  // NODE_FABRIC_OPERATOR_TOKEN
  // NODE_FABRIC_BINDING_TOKEN
  //
  // Member capacity sessions use a domain-separated HMAC derived from the operator token.
  // Anchor pairing grants are one-time and short-lived. Local Anchor signing keys never
  // leave the local machine; Cloudflare stores only their public keys and proof history.
  // The daily cron refreshes recoverable node checkpoints and idempotently emits at most
  // one weekly Button stipend receipt per eligible Anchor.
  //
  // CIVWEAVE_WORKERS_PLAN is a deployment capability flag. Setting it to "paid"
  // only permits funded overage; it does not increase the 10,000-neuron free pool.
  //
  // This Worker intentionally has no Stripe platform key and no Cerbanimo money-edge private key.
}
