{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "civweave-node-cloud-staging",
  "main": "src/staging-entry-v1.mjs",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "GUILD_API_RATE_LIMITER",
      "namespace_id": "41101",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "GUILD_AI_RATE_LIMITER",
      "namespace_id": "41102",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NODES", "class_name": "CivweaveCloudNode" },
      { "name": "CAPACITY", "class_name": "CivweaveCapacityAccount" },
      { "name": "ACCOUNT_DIRECTORY", "class_name": "CivweaveAccountDirectory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CivweaveCloudNode"] },
    { "tag": "v2", "new_sqlite_classes": ["CivweaveCapacityAccount"] },
    { "tag": "v3", "new_sqlite_classes": ["CivweaveAccountDirectory"] }
  ],
  "vars": {
    "NODE_DOMAIN": "cerbanimo.workers.dev",
    "PUBLIC_FABRIC_ORIGIN": "https://civweave-node-cloud-staging.cerbanimo.workers.dev",
    "CIVWEAVE_CORE_ORIGIN": "https://civweave-core-staging.cerbanimo.workers.dev",
    "CIVWEAVE_CANONICAL_INSTALL_ORIGIN": "https://civweave-staging.pages.dev",
    "CIVWEAVE_ACCOUNT_DIRECTORY_ORIGIN": "https://civweave-node-cloud-staging.cerbanimo.workers.dev",
    "CIVWEAVE_WORKERS_PLAN": "free",
    "CIVWEAVE_UNIFIED_BILLING_MODEL": "google/gemini-3.1-flash-lite",
    "CIVWEAVE_AI_GATEWAY_ID": "default",
    "CIVWEAVE_ENVIRONMENT": "staging",
    "CIVWEAVE_PAYMENT_ENVIRONMENT": "stripe-test"
  },
  "observability": { "enabled": true }
}
