{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "civweave-host-edge",
  "main": "src/recovery-entry-v1.mjs",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NODES",
        "class_name": "CivweaveAccountNode"
      },
      {
        "name": "CAPACITY",
        "class_name": "CivweaveCapacityAccount"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CivweaveAccountNode", "CivweaveCapacityAccount"]
    }
  ],
  "vars": {
    "NODE_DOMAIN": "nodes.commonweave.earth",
    "CIVWEAVE_WORKERS_PLAN": "free",
    "CIVWEAVE_ACCOUNT_EDGE_MODE": "path-v1"
  },
  "observability": {
    "enabled": true
  }

  // Account-local secret, generated by provisioning and never committed:
  // NODE_FABRIC_OPERATOR_TOKEN
  //
  // Hub email recovery delivery is optional and transport-pluggable:
  // HUB_RECOVERY_MAILER_URL + secret HUB_RECOVERY_MAILER_TOKEN, or
  // HUB_RECOVERY_EMAIL + HUB_RECOVERY_FROM_EMAIL where Cloudflare Email Service is available.
  //
  // This Worker intentionally has no CORE service binding, Stripe platform key,
  // Cerbanimo signing private key, or central node-fabric binding token.
  // Central money/trust authority remains outside the steward account.
}
