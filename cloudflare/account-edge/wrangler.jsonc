{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "civweave-host-edge",
  "main": "src/recovery-entry-v4.mjs",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "NODES", "class_name": "CivweaveAccountNode" },
      { "name": "CAPACITY", "class_name": "CivweaveCapacityAccount" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CivweaveAccountNode", "CivweaveCapacityAccount"] }
  ],
  "vars": {
    "NODE_DOMAIN": "nodes.commonweave.earth",
    "CIVWEAVE_WORKERS_PLAN": "free",
    "CIVWEAVE_ACCOUNT_EDGE_MODE": "path-v1",
    "HUB_RECOVERY_INBOUND_EMAIL": "recover@commonweave.earth"
  },
  "observability": { "enabled": true }
}
