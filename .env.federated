# Copy this file to .env.federated and replace every example value.

# Public origin other nodes use for discovery and delivery. Internet nodes must use HTTPS.
# Federation v1 expects an origin URL without a path, query, credentials, or fragment.
PUBLIC_HOST_URL=http://localhost:8787

# Human-readable node identity.
CIVWEAVE_NODE_NAME=Civweave Community Node
CIVWEAVE_NODE_DESCRIPTION=A sovereign Civweave community node.

# Host port exposed by Docker Compose.
CIVWEAVE_PORT=8787

# Required for federation administration. Generate a long random value.
# Example: openssl rand -hex 32
CIVWEAVE_FEDERATION_ADMIN_TOKEN=replace-with-a-long-random-token

# Keep false unless the admin API is isolated by another trusted access-control layer.
CIVWEAVE_ALLOW_UNAUTHENTICATED_ADMIN=false

# New peers remain pending until approved unless this is true.
CIVWEAVE_AUTO_ACCEPT_PEERS=false

# Comma-separated advertised capabilities.
CIVWEAVE_NODE_CAPABILITIES=release-distribution,node-discovery,federated-events,fellowfare.exchange,living-school.curricula,anarchadia.proposals,portable-proofs

# Retention and abuse-control limits.
CIVWEAVE_MAX_FEDERATION_EVENTS=5000
CIVWEAVE_MAX_PENDING_PEERS=256

# Optional token protecting the legacy Civweave host-node API.
# This can match the federation token, but separate tokens are easier to rotate independently.
HUB_TOKEN=
