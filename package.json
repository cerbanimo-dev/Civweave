{
  "name": "commonweave-host-node-hub",
  "version": "1.0.25",
  "private": true,
  "description": "Offline-first Commonweave PWA installer and lightweight host node relay.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prestart": "npm run build:install",
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "check": "node --check server.mjs",
    "build:install": "bash scripts/build-install-artifacts.sh"
  }
}
